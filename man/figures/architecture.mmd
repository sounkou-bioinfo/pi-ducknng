flowchart TB
    accTitle: Generic ducknng endpoint architecture
    accDescr: Pi discovers and calls a compatible endpoint selected by URL through DuckDB and vendored ducknng.
    PI["Pi agent"] --> RPC["ducknng_describe() / ducknng_call()"]
    URL["provider-supplied endpoint URL"] -->|"input"| RPC
    RPC --> API["@duckdb/node-api"]
    API --> DB["fresh DuckDB client"]
    DB --> DNNG["vendored ducknng"]
    DNNG <-->|"NNG framed RPC"| SERVER
    subgraph ENDPOINT["compatible ducknng endpoint"]
        SERVER["RPC server"]
        SERVER --> MANIFEST["manifest"]
        SERVER --> METHODS["endpoint-owned methods + state"]
    end
