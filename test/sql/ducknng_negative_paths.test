statement ok
SET VARIABLE negative_tls_id = (
  SELECT max(tls_config_id) FROM ducknng_list_tls_configs()
)

query IT
SELECT ok, error
FROM ducknng_get_rpc_manifest('tcp://127.0.0.1:1', getvariable('negative_tls_id')::UBIGINT)
----
0	ducknng: TLS configuration requires a tls+tcp:// or wss:// URL

query IT
SELECT ok, error
FROM ducknng_open_query('tcp://127.0.0.1:1', 'SELECT 1', 0::UBIGINT, 0::UBIGINT, getvariable('negative_tls_id')::UBIGINT)
----
0	ducknng: TLS configuration requires a tls+tcp:// or wss:// URL

statement ok
SET VARIABLE negative_tls_aio = ducknng_get_rpc_manifest_raw_aio(
  'tcp://127.0.0.1:1',
  100,
  getvariable('negative_tls_id')::UBIGINT
)

query IT
SELECT state, error
FROM ducknng_aio_status(getvariable('negative_tls_aio')::UBIGINT)
----
error	ducknng: TLS configuration requires a tls+tcp:// or wss:// URL

query I
SELECT ducknng_aio_drop(getvariable('negative_tls_aio')::UBIGINT)
----
1

statement ok
SET VARIABLE negative_req_socket = (
  SELECT (ducknng_open_socket('req')).socket_id
)

query ITI
SELECT CASE WHEN r.ok THEN 1 ELSE 0 END, r.error, CASE WHEN r.nng_error IS NULL THEN 1 ELSE 0 END
FROM (SELECT ducknng_dial_socket(
  getvariable('negative_req_socket')::UBIGINT,
  'tcp://127.0.0.1:1',
  100,
  getvariable('negative_tls_id')::UBIGINT
) AS r)
----
0	ducknng: TLS configuration requires a tls+tcp:// or wss:// URL	1

query I
SELECT CASE WHEN (ducknng_close_socket(getvariable('negative_req_socket')::UBIGINT)).ok THEN 1 ELSE 0 END
----
1

query IT
SELECT ok, error
