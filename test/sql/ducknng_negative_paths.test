  ducknng_request_raw('ftp://127.0.0.1:9', from_hex('00'), 10, 0::UBIGINT)
)
----
0	error	6	ducknng: unsupported transport URL scheme

query II
SELECT ducknng_frame_status(from_hex('0103000000000000000001000000000000000000000078')),
       ducknng_frame_status(from_hex('010300000000000000000100000000000000000000007800')) IS NULL
----
255	1

