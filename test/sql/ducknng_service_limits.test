query I
SELECT CASE
  WHEN ducknng_start_server('inflight_rpc', 'tcp://127.0.0.1:0', 2, 134217728, 300000, 0::UBIGINT)
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE inflight_rpc_url = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'inflight_rpc'
)

query I
SELECT CASE WHEN ducknng_set_service_limits('inflight_rpc', 0::UBIGINT, 0::UBIGINT, 1::UBIGINT) THEN 1 ELSE 0 END
----
1

query I
SELECT max_inflight_requests FROM ducknng_list_servers() WHERE name = 'inflight_rpc'
----
1

query I
SELECT CASE WHEN ducknng_set_service_authorizer('inflight_rpc', 'SELECT true AS allow, sleep_ms(2000) AS slept') THEN 1 ELSE 0 END
----
1

statement ok
CREATE TEMP TABLE inflight_aio AS
SELECT ducknng_get_rpc_manifest_raw_aio(getvariable('inflight_rpc_url')::VARCHAR, 4000, 0::UBIGINT) AS aio

query I
WITH RECURSIVE poll(i, c) AS (
  SELECT 1, ducknng_service_inflight('inflight_rpc')
  UNION ALL
  SELECT i + 1, (
      COALESCE(CASE WHEN c < 1 THEN sleep_ms(10) ELSE 0 END, 0) * 0 +
      ducknng_service_inflight('inflight_rpc')
  )
  FROM poll
  WHERE c < 1 AND i < 500
) SELECT c FROM poll ORDER BY i DESC LIMIT 1;
----
1

query IT
SELECT ok, error
FROM ducknng_get_rpc_manifest(getvariable('inflight_rpc_url')::VARCHAR, 0::UBIGINT)
----
0	ducknng: max inflight requests exceeded

query III
SELECT aio_id = (SELECT aio FROM inflight_aio), ok, octet_length(frame) > 0
FROM ducknng_aio_collect((SELECT list_value(aio) FROM inflight_aio), 5000)
----
1	1	1

statement ok
DROP TABLE inflight_aio

query I
SELECT CASE WHEN ducknng_stop_server('inflight_rpc') THEN 1 ELSE 0 END
----
1

# max_inflight_per_principal: TLS service with slow authorizer, AIO + sync pattern

query I
SELECT CASE
  WHEN ducknng_start_server(
    'inflight_principal_rpc',
    'tls+tcp://127.0.0.1:0',
    2,
    134217728,
    300000,
    getvariable('limit_peer_tls_config_id')::UBIGINT
  )
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE inflight_principal_url = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'inflight_principal_rpc'
)

query I
SELECT CASE WHEN ducknng_set_service_limits('inflight_principal_rpc', 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 1::UBIGINT) THEN 1 ELSE 0 END
----
1

query I
SELECT max_inflight_per_principal FROM ducknng_list_servers() WHERE name = 'inflight_principal_rpc'
----
1

query I
SELECT CASE WHEN ducknng_set_service_authorizer('inflight_principal_rpc', 'SELECT true AS allow, sleep_ms(2000) AS slept') THEN 1 ELSE 0 END
----
1

statement ok
CREATE TEMP TABLE inflight_principal_aio AS
SELECT ducknng_get_rpc_manifest_raw_aio(getvariable('inflight_principal_url')::VARCHAR, 4000, getvariable('limit_peer_tls_config_id')::UBIGINT) AS aio

query I
WITH RECURSIVE poll(i, c) AS (
  SELECT 1, ducknng_service_inflight('inflight_principal_rpc')
  UNION ALL
  SELECT i + 1, (
      COALESCE(CASE WHEN c < 1 THEN sleep_ms(10) ELSE 0 END, 0) * 0 +
      ducknng_service_inflight('inflight_principal_rpc')
  )
  FROM poll
  WHERE c < 1 AND i < 500
) SELECT c FROM poll ORDER BY i DESC LIMIT 1;
----
1

query IT
SELECT ok, error
FROM ducknng_get_rpc_manifest(getvariable('inflight_principal_url')::VARCHAR, getvariable('limit_peer_tls_config_id')::UBIGINT)
----
0	ducknng: max inflight requests per principal exceeded

query III
SELECT aio_id = (SELECT aio FROM inflight_principal_aio), ok, octet_length(frame) > 0
FROM ducknng_aio_collect((SELECT list_value(aio) FROM inflight_principal_aio), 2000)
----
1	1	1

statement ok
DROP TABLE inflight_principal_aio

query I
SELECT CASE WHEN ducknng_stop_server('inflight_principal_rpc') THEN 1 ELSE 0 END
----
1

# max_reply_bytes_per_principal: cumulative byte budget
# Start with no limit, make a first successful request, then set limit=1.
# Since cumulative_reply_bytes after the first request >> 1, the second request fails.

query I
SELECT CASE
  WHEN ducknng_start_server(
    'reply_bytes_rpc',
    'tls+tcp://127.0.0.1:0',
    1,
    134217728,
    300000,
    getvariable('limit_peer_tls_config_id')::UBIGINT
  )
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE reply_bytes_url = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'reply_bytes_rpc'
)

query I
SELECT ok
FROM ducknng_get_rpc_manifest(getvariable('reply_bytes_url')::VARCHAR, getvariable('limit_peer_tls_config_id')::UBIGINT)
----
1

query I
SELECT CASE WHEN ducknng_set_service_limits('reply_bytes_rpc', 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 1::UBIGINT) THEN 1 ELSE 0 END
----
1

query I
SELECT max_reply_bytes_per_principal FROM ducknng_list_servers() WHERE name = 'reply_bytes_rpc'
----
1

query IT
SELECT ok, error
FROM ducknng_get_rpc_manifest(getvariable('reply_bytes_url')::VARCHAR, getvariable('limit_peer_tls_config_id')::UBIGINT)
----
0	ducknng: reply byte quota for principal exceeded

query I
SELECT CASE WHEN ducknng_stop_server('reply_bytes_rpc') THEN 1 ELSE 0 END
----
1

# max_session_open_rate_per_principal: cumulative session-open count; set to 1 so second open fails

query I
SELECT CASE
  WHEN ducknng_start_server(
    'session_rate_rpc',
    'tls+tcp://127.0.0.1:0',
    1,
    134217728,
    300000,
    getvariable('limit_peer_tls_config_id')::UBIGINT
  )
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE session_rate_url = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'session_rate_rpc'
)

query I
SELECT CASE WHEN ducknng_set_service_limits('session_rate_rpc', 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 0::UBIGINT, 1::UBIGINT) THEN 1 ELSE 0 END
----
1

query I
SELECT max_session_open_rate_per_principal FROM ducknng_list_servers() WHERE name = 'session_rate_rpc'
----
1

statement ok
CREATE TEMP TABLE session_rate_open AS
SELECT session_id, session_token
FROM ducknng_open_query(
  getvariable('session_rate_url')::VARCHAR,
  'SELECT 31 AS x',
  0::UBIGINT,
  0::UBIGINT,
  getvariable('limit_peer_tls_config_id')::UBIGINT
)
WHERE ok = true

query I
SELECT count(*) FROM session_rate_open
----
1

query IT
SELECT ok, error
FROM ducknng_open_query(
  getvariable('session_rate_url')::VARCHAR,
  'SELECT 32 AS x',
  0::UBIGINT,
  0::UBIGINT,
  getvariable('limit_peer_tls_config_id')::UBIGINT
)
----
0	ducknng: session open rate per principal exceeded

statement ok
SET VARIABLE session_rate_session_id = (SELECT session_id FROM session_rate_open)

statement ok
SET VARIABLE session_rate_session_token = (SELECT session_token FROM session_rate_open)

query I
SELECT ok
FROM ducknng_close_query(
  getvariable('session_rate_url')::VARCHAR,
  getvariable('session_rate_session_id')::UBIGINT,
  getvariable('session_rate_session_token')::VARCHAR,
  getvariable('limit_peer_tls_config_id')::UBIGINT
)
----
