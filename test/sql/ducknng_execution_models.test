# name: test/sql/ducknng_execution_models.test
# group: [ducknng]

require ducknng

query I
SELECT CASE
  WHEN ducknng_start_server('exec_model_svc', 'http://127.0.0.1:0/_ducknng', 1, 134217728, 300000, 0::UBIGINT)
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE exec_model_base = (
  SELECT replace(listen, '/_ducknng', '') FROM ducknng_list_servers() WHERE name = 'exec_model_svc'
)

query T
SELECT execution_model
FROM ducknng_list_servers()
WHERE name = 'exec_model_svc'
----
shared_serialized_connection

query I
SELECT CASE WHEN ducknng_set_service_execution_model('exec_model_svc', 'service_serialized_connection') THEN 1 ELSE 0 END
----
1

query T
SELECT execution_model
FROM ducknng_list_servers()
WHERE name = 'exec_model_svc'
----
service_serialized_connection

query I
SELECT CASE WHEN ducknng_register_http_route(
  'exec_model_svc',
  'GET',
  '/service',
  'SELECT * FROM ducknng_http_text(200, ''service:'' || (SELECT execution_model FROM ducknng_list_servers() WHERE name = ''exec_model_svc''))'
) THEN 1 ELSE 0 END
----
1

query IIT
SELECT ok, status = 200, body_text
FROM ducknng_ncurl(
  getvariable('exec_model_base')::VARCHAR || '/service',
  'GET',
  NULL,
  NULL,
  2000,
  0::UBIGINT
)
----
1	1	service:service_serialized_connection

query I
SELECT CASE WHEN ducknng_set_service_execution_model('exec_model_svc', 'request_connection') THEN 1 ELSE 0 END
----
1

query T
SELECT execution_model
FROM ducknng_list_servers()
WHERE name = 'exec_model_svc'
----
request_connection

query I
SELECT CASE WHEN ducknng_register_http_route(
  'exec_model_svc',
  'GET',
  '/request',
  'SELECT * FROM ducknng_http_text(200, ''request:'' || (SELECT execution_model FROM ducknng_list_servers() WHERE name = ''exec_model_svc''))'
) THEN 1 ELSE 0 END
----
1

query IIT
SELECT ok, status = 200, body_text
FROM ducknng_ncurl(
  getvariable('exec_model_base')::VARCHAR || '/request',
  'GET',
  NULL,
  NULL,
  2000,
  0::UBIGINT
)
----
1	1	request:request_connection

statement error
SELECT ducknng_set_service_execution_model('exec_model_svc', 'bogus')
----
ducknng: execution model must be shared_serialized_connection, service_serialized_connection, or request_connection

query I
SELECT CASE WHEN ducknng_stop_server('exec_model_svc') THEN 1 ELSE 0 END
----
1
