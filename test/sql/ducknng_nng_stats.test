# name: test/sql/ducknng_nng_stats.test
# group: [ducknng]
#
# ducknng_nng_stats() flattens NNG's native statistics tree (nng_stats_get) into
# a table: scope path, name, decoded type/unit, numeric value, and string value.
# This is the low-level observability primitive matching nanonext's stat(); SQL
# filtering and named lookups compose on top of it.

require ducknng

statement ok
SELECT ducknng_start_server('stats_srv', 'tcp://127.0.0.1:0', 1, 134217728, 300000, 0::UBIGINT);

# A snapshot exists and every row is well-formed.
query I
SELECT (count(*) > 0)::INTEGER FROM ducknng_nng_stats()
----
1

query I
SELECT (count(*) = 0)::INTEGER FROM ducknng_nng_stats()
WHERE name IS NULL
   OR type NOT IN ('scope','level','counter','string','boolean','id')
   OR unit NOT IN ('none','bytes','messages','millis','events')
----
1

# The standard NNG socket throughput counters are present with correct units.
query I
SELECT count(DISTINCT name)::INTEGER FROM ducknng_nng_stats()
WHERE scope LIKE 'socket%'
  AND name IN ('tx_bytes','rx_bytes','tx_msgs','rx_msgs')
  AND type = 'counter'
  AND unit IN ('bytes','messages')
----
4

# String-typed stats (e.g. the socket protocol) carry their text in svalue, and
# numeric value is 0 for them.
query I
SELECT (count(*) > 0)::INTEGER FROM ducknng_nng_stats()
WHERE type = 'string' AND svalue IS NOT NULL AND value = 0
----
1
