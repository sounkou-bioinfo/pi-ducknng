# name: test/sql/ducknng_codec_in_rpc.test
# group: [ducknng]
#
# Body codecs run correctly inside service-owned SQL (remote query_rpc), not only
# in a local client query. The codec layer executes its nested DuckDB work on the
# runtime's dedicated codec connection, which is independent of the per-session
# pool connection executing the request, so there is no re-entrancy on the
# request thread's connection. This pins JSON, CSV (both the direct C parser and
# the tempfile-backed reader), and user-registered codecs working over RPC.

require ducknng

statement ok
SELECT ducknng_start_server('codec_rpc2', 'ipc:///tmp/ducknng_codec_in_rpc.ipc', 1, 134217728, 300000, 0::UBIGINT);

statement ok
SELECT ducknng_register_exec_method();

# JSON codec inside RPC.
query I
SELECT a FROM ducknng_query_rpc('ipc:///tmp/ducknng_codec_in_rpc.ipc',
  'SELECT a FROM ducknng_parse_body(''[{"a":7}]''::BLOB, ''application/json'')', 0::UBIGINT)
----
7

# CSV via content-type dispatch (direct C parser) inside RPC.
query I
SELECT b FROM ducknng_query_rpc('ipc:///tmp/ducknng_codec_in_rpc.ipc',
  'SELECT b FROM ducknng_parse_body((concat(''a,b'', chr(10), ''1,x'', chr(10)))::BLOB, ''text/csv'')', 0::UBIGINT)
----
x

# Standalone parse_csv (tempfile + DuckDB read_csv_auto) inside RPC.
query I
SELECT b FROM ducknng_query_rpc('ipc:///tmp/ducknng_codec_in_rpc.ipc',
  'SELECT b FROM ducknng_parse_csv((concat(''a,b'', chr(10), ''1,x'', chr(10)))::BLOB)', 0::UBIGINT)
----
x

# User-registered codec inside RPC.
statement ok
CREATE OR REPLACE FUNCTION rpc_codec_upper(b BLOB) AS upper(b::VARCHAR);

statement ok
SELECT ducknng_register_codec('application/x-rpc-up', 'rpc_codec_upper');

query I
SELECT value FROM ducknng_query_rpc('ipc:///tmp/ducknng_codec_in_rpc.ipc',
  'SELECT value FROM ducknng_parse_body(''hello''::BLOB, ''application/x-rpc-up'')', 0::UBIGINT)
----
HELLO

statement ok
SELECT ducknng_stop_server('codec_rpc2');
