# name: test/sql/ducknng_body_codecs.test
# group: [ducknng]

require ducknng

query I
SELECT count(*) FROM ducknng_list_codecs()
----
11

query IT
SELECT a, b
FROM ducknng_parse_body('[{"a":1,"b":"x"},{"a":2,"b":"y"}]'::BLOB, 'application/json; charset=utf-8')
ORDER BY a
----
1	x
2	y

query T
SELECT output
FROM ducknng_list_codecs()
WHERE provider = 'ducknng_quack_batch'
----
dynamic table

# DuckDB compressed vectors are materialized into ordinary flat output vectors.
# These fixtures follow DuckDB v1.5.2 Vector::Serialize and include exact
# per-chunk DataChunk types plus DataChunk/DataChunkWrapper terminators.
query I
SELECT v
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010176040001012c0164000465000164000effff6600015a00026400006600082a00000000000000ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
42
42
42
42

query I
SELECT v
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010176040001012c0164000365000164000effff6600015a000264000165000800000000000000006600080000000000000000ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
NULL
NULL
NULL

query T
SELECT v
FROM ducknng_parse_body(
  from_hex('010001640019ffff0200010176040001012c01640005650001640019ffff6600015a00035b001402000000000000000200000001000000000000005c0003640000660003016101620163ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
c
a
c
b
a

query T
SELECT v::VARCHAR
FROM ducknng_parse_body(
  from_hex(''),
  'application/vnd.ducknng.quack-batch'
)
----
[12, 13]
[10, 11]
[]
[12, 13]

query I
SELECT v
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010176040001012c0164000465000164000effff6600015a00045b000a5c007effffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
10
8
6
4

query I
SELECT v
FROM ducknng_parse_body(
  from_hex('01000164001effff0200010176040001012c0164000365000164001effff6600015a00045b00035c0002ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
3
5
7

# Payloads emitted by ducknng 0.1.2 omitted per-chunk type lists and placed one
# wrapper terminator after the complete multi-chunk list. They remain readable.
query I
SELECT v
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010176040002012c016400016600016400006600080100000000000000ffffffff012c016400016600016400006600080200000000000000ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
1
2

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('010001640019ffff0200010176040001012c01640001650001640019ffff6600015a0001ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: FSST quack vectors are unsupported

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('010001640019ffff0200010176040001012c01640005650001640019ffff6600015a00035b001403000000000000000200000001000000000000005c0003640000660003016101620163ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack dictionary selection index is out of range

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('010001640019ffff0200010176040001012c01640005650001640019ffff6600015a00035b001400000000010000000200000003000000040000005c0006640000660006016101620163016401650166ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack dictionary count exceeds its selected row count

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('010001640065650001640004c80064000dffffffffffff0200010176040001012c01640001650001640065650001640004c80064000dffffffffffff660001640000680081808002690001640000650081808002ffff6a005a00045b00005c0001ffffffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack materialized value count exceeds supported limit

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('01000164000bffff0200010176040001012c0164000265000164000bffff6600015a00045b00ff005c0001ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack sequence value is out of range for its logical type

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010176040001012c0164000465000164000dffff6600015a00026400006600082a00000000000000ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack chunk type does not match the result schema

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('01000164000effff0200010178040001012c016400808080808080808020660001640000660000ffffffffffffffff'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: invalid fixed-size quack vector payload

statement error
SELECT *
FROM ducknng_parse_body(
  from_hex('0100818004'),
  'application/vnd.ducknng.quack-batch'
)
----
ducknng: quack column count exceeds supported limit

query IT
SELECT a, b
FROM ducknng_parse_body(
  (concat('a,b', chr(10), '1,x', chr(10), '2,y', chr(10)))::BLOB,
  'text/csv'
)
ORDER BY a
----
1	x
2	y

query IT
SELECT a, b
FROM ducknng_parse_body(
  (concat('a', chr(9), 'b', chr(10), '1', chr(9), 'x', chr(10), '2', chr(9), 'y', chr(10)))::BLOB,
  'text/tab-separated-values'
)
ORDER BY a
----
1	x
2	y

query IT
SELECT a, b
FROM ducknng_parse_body(
  (concat('{"a":1,"b":"x"}', chr(10), '{"a":2,"b":"y"}', chr(10)))::BLOB,
  'application/x-ndjson'
)
ORDER BY a
----
1	x
2	y

query TT
SELECT name, value
FROM ducknng_parse_body('foo=bar&baz=hello%20world&plus=a+b'::BLOB, 'application/x-www-form-urlencoded')
ORDER BY name
----
baz	hello world
foo	bar
plus	a b

query T
SELECT body_text
FROM ducknng_parse_body('hello from text'::BLOB, 'text/plain; charset=utf-8')
----
hello from text

query T
SELECT hex(body)
FROM ducknng_parse_body(from_hex('000102'), 'application/octet-stream')
----
000102

query I
SELECT CASE
  WHEN ducknng_start_server('codec_rpc', 'ipc:///tmp/ducknng_body_codecs.ipc', 1, 134217728, 300000, 0::UBIGINT)
  THEN 1 ELSE 0 END
----
1

query I
SELECT CASE WHEN ducknng_register_exec_method() THEN 1 ELSE 0 END
----
1

query IT
SELECT a, b
FROM ducknng_query_rpc(
  'ipc:///tmp/ducknng_body_codecs.ipc',
  'SELECT * FROM ducknng_parse_body(''[{"a":3,"b":"z"}]''::BLOB, ''application/json'')',
  0::UBIGINT
)
----
3	z

query I
SELECT CASE WHEN ducknng_stop_server('codec_rpc') THEN 1 ELSE 0 END
----
1

query I
SELECT CASE
  WHEN ducknng_start_server('codec_http', 'http://127.0.0.1:0/_ducknng', 1, 134217728, 300000, 0::UBIGINT)
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE codec_http_url = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'codec_http'
)

query IT
SELECT ok, type_name
FROM ducknng_ncurl_table(
  getvariable('codec_http_url')::VARCHAR,
  'POST',
  '[{"name":"Content-Type","value":"application/vnd.ducknng.frame"}]',
  from_hex('01000000000000000000000000000000000000000000'),
  2000,
  0::UBIGINT
)
----
1	result

query IT
SELECT ok, type_name
FROM ducknng_ncurl_table(
  getvariable('codec_http_url')::VARCHAR,
  'POST',
  '[{"name":"Content-Type","value":"Application/Vnd.Ducknng.Frame; charset=binary"}]',
  from_hex('01000000000000000000000000000000000000000000'),
  2000,
  0::UBIGINT
)
----
1	result

query I
SELECT CASE WHEN ducknng_stop_server('codec_http') THEN 1 ELSE 0 END
----
1

# --- user codec hooks (ducknng_register_codec / ducknng_unregister_codec) ---

# Define a SQL UDF that the codec layer can dispatch against. Takes a BLOB
# and returns a VARCHAR; the codec hook will splice the function name into
# "SELECT <fn>(?::BLOB)" so the registry only accepts plain identifiers.
statement ok
CREATE OR REPLACE FUNCTION test_codec_upper(b BLOB) AS upper(decode(b))

query I
SELECT CASE WHEN ducknng_register_codec('application/x-test-upper', 'test_codec_upper') THEN 1 ELSE 0 END
----
1

# list_codecs() now reports the user codec alongside built-ins.
query TTTT
SELECT provider, media_types, kind, function_name
FROM ducknng_list_codecs()
WHERE kind = 'user'
ORDER BY media_types
----
user	application/x-test-upper	user	test_codec_upper

# A request whose Content-Type matches the user codec is routed through it,
# producing a single-row "value VARCHAR" table.
query T
SELECT value
FROM ducknng_parse_body('hello'::BLOB, 'application/x-test-upper')
----
HELLO

# Content-type matching is case-insensitive and tolerant of parameters.
query T
SELECT value
FROM ducknng_parse_body('mixed'::BLOB, 'Application/X-Test-Upper; charset=utf-8')
----
MIXED

# User codecs take precedence over built-in providers when the media type matches.
statement ok
CREATE OR REPLACE FUNCTION test_codec_jsonbypass(b BLOB) AS concat('bypass:', decode(b))

query I
SELECT CASE WHEN ducknng_register_codec('application/json', 'test_codec_jsonbypass') THEN 1 ELSE 0 END
----
1

query T
SELECT value
FROM ducknng_parse_body('{"a":1}'::BLOB, 'application/json')
----
bypass:{"a":1}

# Unregister restores the built-in JSON provider.
query I
SELECT CASE WHEN ducknng_unregister_codec('application/json') THEN 1 ELSE 0 END
----
1

query I
SELECT a
FROM ducknng_parse_body('[{"a":42}]'::BLOB, 'application/json')
----
42

# Function name is a plain SQL identifier allowlist; reject injection attempts.
statement error
SELECT ducknng_register_codec('application/x-injection', 'foo; DROP TABLE bar')
----
ducknng: codec function name must be a plain SQL identifier

# Unregistering an unknown codec returns FALSE without erroring.
query I
SELECT CASE WHEN ducknng_unregister_codec('application/x-never-registered') THEN 1 ELSE 0 END
----
0

# Clean up the upper codec.
query I
SELECT CASE WHEN ducknng_unregister_codec('application/x-test-upper') THEN 1 ELSE 0 END
----
1

query I
SELECT count(*) FROM ducknng_list_codecs() WHERE kind = 'user'
----
0

# The decoded-frame envelope projection follows the wire order
# (version, type, status, flags) and is shared by ducknng_decode_frame() and
# the application/vnd.ducknng.frame body codec, which now go through one column
# declaration and one row emitter. Pin the exact projection so the two cannot
# drift apart, or away from ducknng_aio_collect_decoded().
query TT
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM ducknng_decode_frame(
  from_hex('01000000000000000000000000000000000000000000')))
----
ok	BOOLEAN
error	VARCHAR
version	UTINYINT
type	UTINYINT
status	UTINYINT
flags	UINTEGER
type_name	VARCHAR
name	VARCHAR
payload	BLOB
payload_text	VARCHAR

query TT
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM ducknng_parse_body(
  from_hex('01000000000000000000000000000000000000000000'),
  'application/vnd.ducknng.frame'))
----
ok	BOOLEAN
error	VARCHAR
version	UTINYINT
type	UTINYINT
status	UTINYINT
flags	UINTEGER
type_name	VARCHAR
name	VARCHAR
payload	BLOB
payload_text	VARCHAR
