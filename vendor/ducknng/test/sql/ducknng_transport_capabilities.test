# name: test/sql/ducknng_transport_capabilities.test
# group: [ducknng]

require ducknng

# The native backend advertises full transport support with real async and
# native TLS ownership. This is the machine-readable form of the support
# matrix; the browser lanes assert their own descriptor in the browser
# harness.
query I
SELECT json_extract_string(ducknng_transport_capabilities()::JSON, '$.backend')
----
native

query IIIIIII
SELECT json_extract_string(c, '$.http'), json_extract_string(c, '$.https'),
       json_extract_string(c, '$.inproc'), json_extract_string(c, '$.tcp'),
       json_extract_string(c, '$.ipc'), json_extract_string(c, '$.tls_tcp'),
       json_extract_string(c, '$.websocket')
FROM (SELECT ducknng_transport_capabilities()::JSON AS c)
----
supported	supported	supported	supported	supported	supported	supported

query I
SELECT json_extract_string(c, '$.http_response_stream')
FROM (SELECT ducknng_transport_capabilities()::JSON AS c)
----
supported

query IIII
SELECT json_extract(c, '$.async_is_real')::BOOLEAN,
       json_extract(c, '$.honors_timeout')::BOOLEAN,
       json_extract(c, '$.honors_cancel')::BOOLEAN,
       json_extract_string(c, '$.tls_owner')
FROM (SELECT ducknng_transport_capabilities()::JSON AS c)
----
true	true	true	native

# The full contract table carries every build target as data; exactly one row
# is active and it must agree with the scalar descriptor.
query TTTT
SELECT target, http_response_stream, inproc, tls_owner
FROM ducknng_list_transport_capabilities() ORDER BY target
----
native	supported	supported	native
wasm_eh	unsupported	unsupported	browser_managed
wasm_threads	unsupported	experimental	browser_managed

query I
SELECT target FROM ducknng_list_transport_capabilities() WHERE active
----
native

query I
SELECT count(*)::INTEGER
FROM ducknng_list_transport_capabilities() t,
     (SELECT ducknng_transport_capabilities()::JSON AS c) s
WHERE t.active
  AND t.target = json_extract_string(s.c, '$.backend')
  AND t.http = json_extract_string(s.c, '$.http')
  AND t.websocket = json_extract_string(s.c, '$.websocket')
  AND t.http_response_stream = json_extract_string(s.c, '$.http_response_stream')
  AND t.async_is_real = json_extract(s.c, '$.async_is_real')::BOOLEAN
  AND t.tls_owner = json_extract_string(s.c, '$.tls_owner')
----
1
