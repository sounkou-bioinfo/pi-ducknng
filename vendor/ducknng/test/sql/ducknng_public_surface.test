# name: test/sql/ducknng_public_surface.test
# group: [ducknng]

require ducknng

query I
WITH loaded AS (
  SELECT DISTINCT function_name AS name
  FROM duckdb_functions()
  WHERE function_name LIKE 'ducknng%'
    AND function_name NOT LIKE 'ducknng__%'
),
catalog AS (
  SELECT (unnest(functions)).name AS name
  FROM read_json_auto('function_catalog/functions.yaml')
)
SELECT count(*)::INTEGER
FROM (
  SELECT name FROM loaded
  EXCEPT
  SELECT name FROM catalog
)
----
0

query I
SELECT count(*)::INTEGER
FROM duckdb_functions()
WHERE function_name = 'ducknng__aio_mark_collected'
----
0

query I
WITH expected(name) AS (
  VALUES
    ('ducknng__ncurl_row'),
    ('ducknng_start_server'),
    ('ducknng_stop_server'),
    ('ducknng_set_service_peer_allowlist'),
    ('ducknng_set_service_ip_allowlist'),
    ('ducknng_run_rpc_raw'),
    ('ducknng_get_rpc_manifest_raw'),
    ('ducknng_open_query_raw'),
    ('ducknng_fetch_query_raw'),
    ('ducknng_close_query_raw'),
    ('ducknng_cancel_query_raw'),
    ('ducknng_request_raw'),
    ('ducknng_request_socket_raw')
)
SELECT count(*)::INTEGER
FROM duckdb_functions() f
JOIN expected e ON f.function_name = e.name
WHERE f.function_type = 'scalar'
  AND (f.stability IS NULL OR f.stability <> 'VOLATILE')
----
0
