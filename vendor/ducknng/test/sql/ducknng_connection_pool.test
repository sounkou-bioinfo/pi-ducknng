# name: test/sql/ducknng_connection_pool.test
# group: [ducknng]
#
# The runtime execution-connection pool starts at a warm minimum and grows on
# demand up to a ceiling, then waits (bounded) for a release before reporting
# exhaustion. This test pins the growth behaviour: a single statement that nests
# several correlated query_rpc table functions holds many sessions at once (each
# query_rpc holds a pooled connection from bind through scan). With a fixed pool
# of 8 this exhausted and errored; with grow-on-demand the statement obtains the
# connections it needs and completes.

require ducknng

statement ok
SELECT ducknng_start_server('cpool', 'ipc:///tmp/ducknng_connection_pool.ipc', 1, 134217728, 300000, 0::UBIGINT);

statement ok
SELECT ducknng_register_exec_method();

# Three correlated query_rpc subqueries over 12 rows: well beyond the 8 warm
# connections, so this only passes if the pool grows on demand.
query III
SELECT max(a)::INTEGER, max(b)::INTEGER, max(c)::INTEGER FROM (
  SELECT
    (SELECT v FROM ducknng_query_rpc_mode('ipc:///tmp/ducknng_connection_pool.ipc',
      'SELECT 1::INTEGER AS v', 0::UBIGINT, 'arrow_ipc_stream')) AS a,
    (SELECT v FROM ducknng_query_rpc_mode('ipc:///tmp/ducknng_connection_pool.ipc',
      'SELECT 2::INTEGER AS v', 0::UBIGINT, 'arrow_ipc_stream')) AS b,
    (SELECT v FROM ducknng_query_rpc_mode('ipc:///tmp/ducknng_connection_pool.ipc',
      'SELECT 3::INTEGER AS v', 0::UBIGINT, 'arrow_ipc_stream')) AS c
  FROM range(12)
)
----
1	2	3

# Repeated independent sessions still work after the pool has grown: connections
# are returned to the pool (reset) and reused rather than leaked.
query I
SELECT v FROM ducknng_query_rpc_mode('ipc:///tmp/ducknng_connection_pool.ipc',
  'SELECT 99::INTEGER AS v', 0::UBIGINT, 'arrow_ipc_stream')
----
99

# The grow ceiling is controlled by SQL functions (deterministic, no env vars).
query I
SELECT ducknng_execution_pool_max()
----
64

# Setter returns the effective value; out-of-range requests are clamped.
query I
SELECT ducknng_set_execution_pool_max(128)
----
128

query I
SELECT ducknng_execution_pool_max()
----
128

query I
SELECT ducknng_set_execution_pool_max(0)
----
1

query I
SELECT ducknng_set_execution_pool_max(1000000)
----
1024

statement ok
SELECT ducknng_set_execution_pool_max(64);

statement ok
SELECT ducknng_stop_server('cpool');
