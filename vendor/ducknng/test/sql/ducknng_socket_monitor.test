# name: test/sql/ducknng_socket_monitor.test
# group: [ducknng]
#
# Client-socket pipe-event monitoring (nanonext monitor() / read_monitor()
# parity). ducknng_monitor_socket(socket_id) opts a client socket into pipe-event
# capture; ducknng_read_socket_monitor(socket_id, after_seq, max_events) returns
# the captured add/remove events. This complements the service-side
# ducknng_read_monitor(), which only covers server rep sockets.

require ducknng

# Open a PAIR socket and start monitoring it before any pipe forms.
statement ok
SET VARIABLE mon_a = (ducknng_open_socket('pair')).socket_id;

query I
SELECT ducknng_monitor_socket(getvariable('mon_a'))
----
true

statement ok
SELECT (ducknng_listen_socket(getvariable('mon_a'), 'inproc://ducknng_socket_monitor_t', 1048576, 0::UBIGINT)).ok;

# A second PAIR socket dials in, forming a pipe on the monitored socket.
statement ok
SET VARIABLE mon_b = (ducknng_open_socket('pair')).socket_id;

statement ok
SELECT (ducknng_dial_socket(getvariable('mon_b'), 'inproc://ducknng_socket_monitor_t', 1000, 0::UBIGINT)).ok;

# The monitor captured exactly one 'add' event with a monotonic seq and no drops.
query III
SELECT count(*)::INTEGER, (max(seq) >= 1)::INTEGER, (max(dropped) = 0)::INTEGER
FROM ducknng_read_socket_monitor(getvariable('mon_a'), 0::UBIGINT, 0::UBIGINT)
WHERE event = 'add'
----
1	1	1

# after_seq filters already-seen events: nothing newer than the latest seq.
statement ok
SET VARIABLE last_seq = (SELECT max(seq) FROM ducknng_read_socket_monitor(getvariable('mon_a'), 0::UBIGINT, 0::UBIGINT));

query I
SELECT count(*)::INTEGER
FROM ducknng_read_socket_monitor(getvariable('mon_a'), getvariable('last_seq')::UBIGINT, 0::UBIGINT)
----
0

# cv wait: an event is already present, so wait returns its seq immediately.
query I
SELECT (ducknng_socket_monitor_wait(getvariable('mon_a'), 0::UBIGINT, 1000::UBIGINT) >= 1)::INTEGER
----
1

# cv wait: nothing newer than a far-future seq, so it times out (bounded) and
# returns the current seq unchanged rather than hanging.
query I
SELECT ducknng_socket_monitor_wait(getvariable('mon_a'), 1000000::UBIGINT, 150::UBIGINT)
----
1

# Reading a socket that was never monitored is a clean error, not a crash.
statement ok
SET VARIABLE mon_c = (ducknng_open_socket('pair')).socket_id;

# Waiting on an unmonitored socket is likewise a clean error.
statement error
SELECT ducknng_socket_monitor_wait(getvariable('mon_c'), 0::UBIGINT, 10::UBIGINT)
----

statement error
SELECT * FROM ducknng_read_socket_monitor(getvariable('mon_c'), 0::UBIGINT, 0::UBIGINT)
----

statement ok
SELECT (ducknng_close_socket(getvariable('mon_a'))).ok;

statement ok
SELECT (ducknng_close_socket(getvariable('mon_b'))).ok;

statement ok
SELECT (ducknng_close_socket(getvariable('mon_c'))).ok;
